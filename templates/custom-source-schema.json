{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "港股财报诊断 Skill 自定义数据源 Schema",
  "description": "API/数据库型自定义数据源的结构契约。field_id 对照 references/indicator-dictionary.md 数据需求清单编号（发布后冻结，不得复用或重排）。meta 口径声明对应 C2 校验；source_note 对应 C4 溯源校验。",
  "type": "object",
  "required": ["meta", "records"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["source_name", "provider_type", "is_consolidated", "uses_parent_net_profit", "fiscal_year_end", "extracted_at"],
      "additionalProperties": false,
      "properties": {
        "source_name": {
          "type": "string",
          "description": "数据源名称（C4 可溯源声明）"
        },
        "provider_type": {
          "type": "string",
          "enum": ["excel", "wind", "ifind", "choice", "bloomberg", "internal_api", "other"]
        },
        "is_consolidated": {
          "type": "boolean",
          "description": "合并报表口径声明（C2），准入要求必须为 true"
        },
        "uses_parent_net_profit": {
          "type": "boolean",
          "description": "利润字段为本公司拥有人应占溢利（归母）声明（C2），准入要求必须为 true"
        },
        "fiscal_year_end": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}$",
          "description": "财年截止日（MM-DD）：港股财年多样（12-31 / 03-31 / 06-30 均常见），必须显式声明"
        },
        "accounting_standards": {
          "type": "string",
          "description": "会计准则口径：HKFRS / IFRS / CAS（H 股公司常见）"
        },
        "caliber_note": {
          "type": "string",
          "description": "口径补充说明（可选）：报告期口径、单位换算说明等"
        },
        "extracted_at": {
          "type": "string",
          "format": "date",
          "description": "数据提取时间（YYYY-MM-DD）"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stock_code", "period", "field_id", "value", "unit", "currency", "source_note"],
        "additionalProperties": false,
        "properties": {
          "stock_code": {
            "type": "string",
            "pattern": "^\\d{4,5}\\.HK$",
            "description": "港股代码（5 位前导零 + .HK 后缀，如 00700.HK）"
          },
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "报告期期末日（YYYY-MM-DD，与 meta.fiscal_year_end 对齐）"
          },
          "field_id": {
            "type": "string",
            "pattern": "^[A-D]\\d{2}[ab]?$|^E[1-3]-[AB]\\d{2}$",
            "description": "字段编号：A01–A38 / B01–B27 / C02–C12 / D01–D22；E 组仅接受槽位编址（如 E1-A01）；[ab] 后缀仅 B06a/B06b 实际使用"
          },
          "field_name": {
            "type": "string",
            "description": "字段中文名（与字典对照，便于人读）"
          },
          "value": {
            "type": ["number", "null"],
            "description": "数值；null 视同 MISSING（禁止估算填充）；结构性零值字段（A37/B24/A38/C08）无此科目填 0"
          },
          "unit": {
            "type": "string",
            "enum": ["yuan", "wanyuan", "yiyuan", "per_share", "text", "date"]
          },
          "currency": {
            "type": "string",
            "enum": ["CNY", "HKD", "USD", "EUR", "GBP", "SGD", "JPY", "KRW"]
          },
          "source_note": {
            "type": "string",
            "description": "溯源标识（接口/库表/文件 + 提取批次；披露易原文须注明年报页码）"
          }
        }
      }
    }
  }
}
